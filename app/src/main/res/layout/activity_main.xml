<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:ignore="HardcodedText">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

    <!-- 涓诲唴瀹癸細宸﹀皝闈紝鍙充俊鎭?+ 鎾斁鎺у埗 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <!-- 宸︿晶锛氫笓杈戝皝闈紙瀹藉害闅忓皝闈㈣嚜閫傚簲锛屼笂涓嬪眳涓紝涓庢挱鏀剧粍浠跺榻愶級 -->
        <LinearLayout
            android:id="@+id/left_panel"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="18dp"
            android:paddingBottom="18dp"
            android:paddingStart="42dp"
            android:paddingEnd="10dp">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/album_art"
                android:layout_width="320dp"
                android:layout_height="320dp"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/bg_art_placeholder"
                android:contentDescription="@string/now_playing"
                android:padding="4dp"
                android:scaleType="centerCrop"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.AirMusic.Rounded"
                app:srcCompat="@drawable/ic_music_note" />
        </LinearLayout>

        <!-- 鍙充晶锛氭瓕鏇蹭俊鎭湪涓婏紝鎾斁鎺у埗灞呬腑锛堝皝闈㈠彉澶у悗鐩稿簲鍙崇Щ锛?-->
        <LinearLayout
            android:id="@+id/right_panel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="58"
            android:gravity="top"
            android:orientation="vertical"
            android:paddingTop="56dp"
            android:paddingStart="36dp"
            android:paddingEnd="24dp">

            <TextView
                android:id="@+id/track_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:maxLines="2"
                android:text="@string/unknown_title"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/track_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/unknown_artist"
                android:textColor="@color/accent"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/track_album"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/unknown_album"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/source_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_chip"
                android:paddingStart="14dp"
                android:paddingTop="5dp"
                android:paddingEnd="14dp"
                android:paddingBottom="5dp"
                android:text="@string/source_idle"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <!-- 鎾斁缁勪欢锛氬湪鍙充晶鍓╀綑绌洪棿涓瀭鐩村眳涓?-->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/seek_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <SeekBar
                        android:id="@+id/seek_bar"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:max="1000"
                        android:progressTint="@color/accent"
                        android:thumbTint="@color/accent" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/position_text"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="0:00"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/duration_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0:00"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="52dp"
                        android:layout_height="52dp">

                        <ImageButton
                            android:id="@+id/btn_prev"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@android:color/transparent"
                            android:contentDescription="@string/previous"
                            android:src="@drawable/ic_prev"
                            android:tint="@color/text_primary" />

                        <ProgressBar
                            android:id="@+id/prev_progress"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:indeterminateTint="@color/text_primary"
                            android:visibility="gone" />
                    </FrameLayout>

                    <FrameLayout
                        android:layout_width="68dp"
                        android:layout_height="68dp"
                        android:layout_marginStart="18dp"
                        android:layout_marginEnd="18dp">

                        <ImageButton
                            android:id="@+id/btn_play"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_play"
                            android:contentDescription="@string/play"
                            android:padding="16dp"
                            android:src="@drawable/ic_play"
                            android:tint="@color/background" />

                        <ProgressBar
                            android:id="@+id/play_progress"
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:layout_gravity="center"
                            android:indeterminateTint="@color/background"
                            android:visibility="gone" />
                    </FrameLayout>

                    <FrameLayout
                        android:layout_width="52dp"
                        android:layout_height="52dp">

                        <ImageButton
                            android:id="@+id/btn_next"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@android:color/transparent"
                            android:contentDescription="@string/next"
                            android:src="@drawable/ic_next"
                            android:tint="@color/text_primary" />

                        <ProgressBar
                            android:id="@+id/next_progress"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:indeterminateTint="@color/text_primary"
                            android:visibility="gone" />
                    </FrameLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- 搴曢儴鏍忥細搴旂敤鍚?+ 鏇插簱 + 璁剧疆 + 搴旂敤 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="8dp"
        android:paddingEnd="10dp"
        android:paddingBottom="8dp">

        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp">

            <ImageButton
                android:id="@+id/btn_multicast"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="center"
                android:background="@android:color/transparent"
                android:contentDescription="@string/multicast"
                android:src="@drawable/ic_multicast"
                android:tint="@color/accent" />

            <ProgressBar
                android:id="@+id/multicast_progress"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:indeterminateTint="@color/accent"
                android:visibility="gone" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal">

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="0.25" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.5"
                android:gravity="center">

                <ImageView
                    android:id="@+id/volume_icon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@string/volume"
                    android:src="@drawable/ic_volume"
                    android:tint="@color/text_primary" />

                <SeekBar
                    android:id="@+id/volume_seek"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:max="100"
                    android:progressTint="@color/accent"
                    android:thumbTint="@color/accent" />
            </LinearLayout>

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="0.25" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_library"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/library"
            android:src="@drawable/ic_folder"
            android:tint="@color/accent" />

        <ImageButton
            android:id="@+id/btn_settings"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/settings"
            android:src="@drawable/ic_settings"
            android:tint="@color/accent" />

        <ImageButton
            android:id="@+id/btn_apps"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/apps"
            android:src="@drawable/ic_apps"
            android:tint="@color/accent" />

    </LinearLayout>
    </LinearLayout>
</FrameLayout>
